{
  "expo": {
    "name": "Gestor de Rutas",
    "slug": "gestor-rutas-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "useCleartextTraffic": true
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Gestor de Rutas necesita tu ubicación para calcular las distancias en tiempo real hacia las entregas."
        }
      ]
    ]
  }
}
